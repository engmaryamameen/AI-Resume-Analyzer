{
  "name": "resume-intel-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint --ext .ts,.tsx src --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.mts *.mjs *.json",
    "format:check": "prettier --check src tests scripts *.ts *.mts *.mjs *.json"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "~19.0.0",
    "react-dom": "~19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "~6.6.0",
    "@testing-library/react": "~16.1.0",
    "@testing-library/user-event": "~14.5.0",
    "@types/node": "^22.12.0",
    "@types/react": "~19.0.0",
    "@types/react-dom": "~19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "~10.4.0",
    "axe-core": "~4.10.0",
    "eslint": "~8.57.0",
    "eslint-config-next": "~15.1.0",
    "jsdom": "~25.0.0",
    "postcss": "8.5.32",
    "prettier": "3.6.2",
    "tailwindcss": "~3.4.0",
    "typescript": "~5.7.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss": "8.5.32"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
