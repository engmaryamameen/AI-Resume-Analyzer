# Local development only. Production needs a random secret and HTTPS.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://margin:margin_local@localhost:55432/margin_notes
SECRET_KEY=CHANGE_ME_generate_a_random_secret_for_production
STORAGE_DIR=backend/storage
ML_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Compose uses these to initialize its dedicated database.
POSTGRES_USER=margin
POSTGRES_PASSWORD=margin_local
POSTGRES_DB=margin_notes
