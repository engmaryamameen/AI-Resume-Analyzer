# Local development only. Production needs a random secret and HTTPS.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://margin:margin_local@localhost:55432/margin_notes
SECRET_KEY=CHANGE_ME_generate_a_random_secret_for_production
STORAGE_DIR=backend/storage
ML_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Compose uses these to initialize its dedicated database.
POSTGRES_USER=margin
POSTGRES_PASSWORD=margin_local
POSTGRES_DB=margin_notes

# Account email delivery. Fill manually; use a TLS SMTP endpoint on port 465.
PUBLIC_APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Stripe sandbox checkout; live keys are deliberately rejected.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local generative review. Provision the model before enabling the ai-review Compose profile.
REVIEWER_ENABLED=false
REVIEWER_URL=http://review-model:11434
REVIEWER_MODEL=qwen3:4b-instruct
REVIEWER_MODEL_DIGEST=
REVIEWER_TIMEOUT_SECONDS=300
# Keep local installation reviews free even when demonstrating Stripe checkout.
BILLING_REQUIRE_CREDITS=false
